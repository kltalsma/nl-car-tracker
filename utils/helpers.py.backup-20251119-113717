def extract_province_from_location(city: str, coords: Tuple[float, float] = None) -> Optional[str]:
    """
    Extract province name from a city using geocoding
    
    Args:
        city: City name
        coords: Optional coordinates if already known
        
    Returns:
        Province name or None if cannot be determined
    """
    if not city and not coords:
        return None
    
    try:
        # If we have coords, do reverse geocoding
        if coords:
            from geopy.geocoders import Nominatim
            result = geolocator.reverse(coords, language='nl')
            if result and result.raw:
                address = result.raw.get('address', {})
                # Try different keys for province/state
                province = (address.get('state') or 
                          address.get('province') or 
                          address.get('county'))
                if province:
                    return province
        
        # If we have city name, geocode it and extract province from result
