        car_features: List of feature strings from the car listing
        
    Returns:
        Tuple of (present_features, missing_features) where each is a list of feature names
    """
    present = []
    missing = []
    
    for required in required_features:
        if check_feature_match(required, car_features):
            present.append(required)
        else:
            missing.append(required)
    
    return present, missing


