def validate_fuel_type_by_battery(fuel_type: str, battery_size: Optional[float], model: str) -> tuple[str, list]:
    """
    Validate and potentially correct fuel_type based on battery size
    
    PHEVs typically have 8-18 kWh batteries, while Full Electric vehicles have 30+ kWh batteries.
    This function checks for misclassifications and returns corrections with warnings.
    
    Args:
        fuel_type: Current fuel type classification (e.g., "Full Electric", "PHEV")
        battery_size: Battery capacity in kWh (if known)
        model: Vehicle model name (used for additional validation)
    
    Returns:
        Tuple of (corrected_fuel_type, list_of_warnings)
        
    Examples:
        >>> validate_fuel_type_by_battery("PHEV", 64.0, "Niro")
        ("Full Electric", ["Suspicious: PHEV with large battery (64.0 kWh) - corrected to Full Electric"])
        
        >>> validate_fuel_type_by_battery("Full Electric", 12.0, "Niro PHEV")
        ("PHEV", ["Suspicious: Full Electric with small battery (12.0 kWh) - corrected to PHEV"])
    """
    warnings = []
    
    if not battery_size or not fuel_type:
        return fuel_type, warnings
    
    # Full Electric validation
    if fuel_type == 'Full Electric':
        if battery_size < 30:
            warning = f"Suspicious: Full Electric with small battery ({battery_size} kWh)"
            warnings.append(warning)
            logger.warning(warning)
            
            # Check if model name suggests PHEV
            model_lower = model.lower()
            if any(keyword in model_lower for keyword in ['phev', 'plug-in', 'hybrid', 'e-hybrid']):
                corrected = "PHEV"
                correction_msg = f" - corrected to {corrected}"
                warnings[-1] += correction_msg
                logger.info(f"Correcting fuel type for {model}: Full Electric -> {corrected}")
                return corrected, warnings
    
    # PHEV validation  
    elif fuel_type == 'PHEV':
        if battery_size > 30:
            warning = f"Suspicious: PHEV with large battery ({battery_size} kWh)"
            warnings.append(warning)
            logger.warning(warning)
            
            # Large battery (>30 kWh) strongly indicates Full Electric, not PHEV
            # PHEVs rarely exceed 20 kWh
            corrected = "Full Electric"
            correction_msg = f" - corrected to {corrected}"
            warnings[-1] += correction_msg
            logger.info(f"Correcting fuel type for {model}: PHEV -> {corrected}")
            return corrected, warnings
    
    return fuel_type, warnings


