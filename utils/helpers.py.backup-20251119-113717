def extract_city_from_address(address: str) -> Optional[str]:
    """
    Extract just the city name from a full address string
    
    Args:
        address: Full address string (e.g., "Kelvinstraat 4, 6003 DH, WEERT" or "1234AB Amsterdam")
        
    Returns:
        City name or None if cannot be extracted
    """
    if not address:
        return None
    
    import re
    
    # Common Dutch address formats:
    # 1. "Street 123, 1234AB, CITY" or "Street 123, 1234 AB, CITY"
    # 2. "1234AB CITY" or "1234 AB CITY"
    # 3. "CITY" (just city name)
    
    # Try pattern: comma-separated parts with postal code
    # Look for postal code (4 digits + 2 letters) followed by city
    postal_match = re.search(r'[1-9]\d{3}\s*[A-Z]{2}[,\s]+([A-Za-z][A-Za-z\s\'-]+?)(?:,|$)', address)
    if postal_match:
        city = postal_match.group(1).strip()
        # Clean up - remove any trailing numbers or special chars
        city = re.sub(r'[\d]+$', '', city).strip()
        return city
    
    # Try pattern: parts separated by commas, city is usually last or second to last
    parts = [p.strip() for p in address.split(',')]
    if len(parts) >= 2:
        # Check last part - it might be city
        last_part = parts[-1].strip()
        # Remove postal code if present at start
        last_clean = re.sub(r'^[1-9]\d{3}\s*[A-Z]{2}\s*', '', last_part).strip()
        if last_clean and not last_clean[0].isdigit():
            return last_clean
        
        # Try second to last part
        if len(parts) >= 3:
            second_last = parts[-2].strip()
            second_clean = re.sub(r'^[1-9]\d{3}\s*[A-Z]{2}\s*', '', second_last).strip()
            if second_clean and not second_clean[0].isdigit():
                return second_clean
    
    # Fallback: remove street address and postal code from beginning
    # Pattern: "Street 123, 1234AB CITY" -> "CITY"
    cleaned = re.sub(r'^[^,]+,\s*', '', address)  # Remove street part
    cleaned = re.sub(r'^[1-9]\d{3}\s*[A-Z]{2}\s*', '', cleaned).strip()  # Remove postal code
    
    if cleaned and not cleaned[0].isdigit() and len(cleaned) > 2:
        return cleaned
    
    return None


def get_coordinates(location: str) -> Optional[Tuple[float, float]]:
    """
    Get latitude and longitude for a location string
    
    Args:
        location: Location string (city name, address, etc.)
        
    Returns:
        Tuple of (latitude, longitude) or None if not found
    """
    if not location:
        return None
    
    # Check cache first
    location_key = location.lower().strip()
    if location_key in _geocoding_cache:
        return _geocoding_cache[location_key]
    
    try:
        # Add Netherlands to improve accuracy
        search_query = f"{location}, Netherlands"
        # Reduced timeout from 10s to 3s to minimize impact of failures
        # With 2 retries at urllib3 level, max wait time is ~9s instead of ~30s
        result = geolocator.geocode(search_query, timeout=3)  # type: ignore
        
        if result:
            coords = (result.latitude, result.longitude)  # type: ignore
            _geocoding_cache[location_key] = coords
            logger.debug(f"Geocoded {location} -> {coords}")
            
            # Delay to respect Nominatim rate limits (1 request/second)
            time.sleep(1.5)
            
            return coords
        else:
            # Cache the failure to avoid retrying the same address
            _geocoding_cache[location_key] = None
            logger.warning(f"Could not geocode location: {location}")
            return None
    
    except Exception as e:
        # Cache the failure to avoid retrying the same address
        _geocoding_cache[location_key] = None
        logger.error(f"Error geocoding {location}: {e}")
        return None


