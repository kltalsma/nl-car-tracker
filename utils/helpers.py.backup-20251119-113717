def extract_battery_size(model_str: str) -> Optional[str]:
    """
    Extract battery size from model name
    
    Args:
        model_str: Model string (e.g., "ID.4 Pro 77 kWh", "iX xDrive50")
        
    Returns:
        Battery size as string (e.g., "77", "105") or None if not found
    """
    if not model_str:
        return None
    
    import re
    
    # Look for patterns like "77 kWh", "77kWh", "80 kwh"
    kwh_match = re.search(r'(\d+)\s*k?wh', model_str, re.IGNORECASE)
    if kwh_match:
        return kwh_match.group(1)
    
    # Don't extract numbers from model variant names like "iV 80", "EV6", "i4"
    # These are model designations, not battery sizes
    # Exception: If the number is >38 and appears after certain keywords
    
    # Look for standalone battery sizes (e.g., "60", "77", "82")
    # Common battery sizes: 39-107 kWh range
    # But avoid matching model numbers like "iV 80" in "Enyaq iV 80"
    
    # Skip if number appears right after "iV", "EV", "i" (model designation)
    if re.search(r'\b(iv|ev|i)\s*\d+', model_str, re.IGNORECASE):
        # This is likely a model designation, not battery size
        # However, still check for explicit kWh mentions elsewhere in the string
        pass
    
    # Look for numbers in battery range that aren't model designations
    number_match = re.search(r'\b(3[9]|4[0-9]|5[0-8]|6[0-9]|7[0-9]|8[0-9]|9[0-9]|10[0-7])\b', model_str)
    if number_match:
        # Extra validation: make sure it's not part of a model designation
        num = number_match.group(1)
        # Get context around the number
        match_pos = number_match.start()
        before_text = model_str[max(0, match_pos-5):match_pos].lower()
        
        # If preceded by model designation indicators, skip it
        if not any(x in before_text for x in ['iv ', 'ev', 'i ', 'model ']):
            return num
    
    return None


