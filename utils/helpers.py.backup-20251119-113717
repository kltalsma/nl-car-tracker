def calculate_distance_from_heerenveen(location: Optional[str] = None, coords: Optional[Tuple[float, float]] = None) -> Optional[float]:
    """
    Calculate driving distance from Heerenveen in kilometers using OSRM routing
    
    Args:
        location: Location string (city name, address, etc.)
        coords: Tuple of (latitude, longitude) if already known
        
    Returns:
        Driving distance in kilometers or None if cannot be calculated
    """
    target_coords = coords
    
    # Get coordinates if not provided
    if not target_coords and location:
        # Extract city name from location string (remove postal code, etc.)
        # Common formats: "Amsterdam", "1234AB Amsterdam", "Amsterdam, Noord-Holland"
        city_parts = location.split(',')[0].strip()  # Get first part before comma
        # Remove postal code pattern (digits + letters)
        import re
        city = re.sub(r'^\d+[A-Z]*\s+', '', city_parts).strip()
        
        if city:
            target_coords = get_coordinates(city)
        else:
            target_coords = get_coordinates(location)
    
    if not target_coords:
        return None
    
    try:
        # Use OSRM public API for driving distance
        # Format: http://router.project-osrm.org/route/v1/driving/lon1,lat1;lon2,lat2
        # Note: OSRM uses (longitude, latitude) format, not (latitude, longitude)
        
        # Heerenveen coordinates: (lat, lon) = (52.9594, 5.9201)
        # Target coordinates: (lat, lon)
        url = f"http://router.project-osrm.org/route/v1/driving/{HEERENVEEN_COORDS[1]},{HEERENVEEN_COORDS[0]};{target_coords[1]},{target_coords[0]}"
        params = {
            'overview': 'false',  # We don't need the route geometry
            'steps': 'false'      # We don't need turn-by-turn directions
        }
        
        response = requests.get(url, params=params, timeout=10)
        response.raise_for_status()
        
        data = response.json()
        
        if data.get('code') == 'Ok' and data.get('routes'):
            # Distance is in meters, convert to kilometers
            distance_km = data['routes'][0]['distance'] / 1000.0
            logger.debug(f"Calculated driving distance from Heerenveen to {location or target_coords}: {distance_km:.2f} km")
            return round(distance_km, 2)
        else:
            logger.warning(f"OSRM API did not return a route: {data.get('code')}")
            # Fallback to geodesic (straight-line) distance
            distance = geodesic(HEERENVEEN_COORDS, target_coords).kilometers
            logger.debug(f"Using geodesic fallback distance: {distance:.2f} km")
            return round(distance, 2)
            
    except Exception as e:
        logger.error(f"Error calculating driving distance (falling back to geodesic): {e}")
        # Fallback to geodesic distance on error
        try:
            distance = geodesic(HEERENVEEN_COORDS, target_coords).kilometers
            return round(distance, 2)
        except Exception as e2:
            logger.error(f"Error calculating geodesic distance: {e2}")
            return None


def is_mild_hybrid(fuel_type_str: str = None, model_str: str = None) -> bool:
    """
    Detect if a vehicle is a mild hybrid (MHEV/eTSI) which should be excluded
    
    Mild hybrids cannot be plugged in and have no electric-only range.
    They use a small battery to assist the engine but cannot drive on electricity alone.
    
    Args:
        fuel_type_str: Raw fuel type string from website
        model_str: Vehicle model string (mild hybrid designation often appears here)
        
    Returns:
        True if vehicle is a mild hybrid, False otherwise
    """
    # Check fuel type string
    if fuel_type_str:
        fuel_lower = fuel_type_str.lower().strip()
        # Mild hybrid indicators
        if any(term in fuel_lower for term in ['mhev', 'mild hybrid', 'mild-hybrid', 'etsi', 'e-tsi']):
            return True
    
    # Check model string  
    if model_str:
        model_lower = model_str.lower().strip()
        # Mild hybrid indicators in model name
        if any(term in model_lower for term in ['mhev', 'mild hybrid', 'mild-hybrid', 'etsi', 'e-tsi']):
            return True
    
    return False


def normalize_model_name(model_str: str) -> str:
    """
    Extract clean model name from full model string
    
    Many car listing titles include extra information after the model name like:
    - "EV6 Plus 77.4 kWh NL-Auto!! Leder I Camera I Apple Car" → "EV6"
    - "Enyaq iV 80" → "Enyaq"
    - "ID.4 Pro Performance 77 kWh" → "ID.4"
    
    Args:
        model_str: Full model string from listing title
        
    Returns:
        Clean model name (first 1-3 words that make up the actual model)
    """
    if not model_str:
        return model_str
    
    import re
    
    # Split into words
    words = model_str.split()
    if not words:
        return model_str
    
    # Patterns that indicate we've reached the trim/variant/features section
    trim_indicators = [
        r'^\d+\.?\d*\s*k?wh',  # Battery size: "77.4 kWh", "77kWh"
        r'^\d+pk$',            # Power: "150pk"
        r'^\d+kw$',            # Power: "110kW"
        r'^iv\s+\d+',          # "iV 80", "iV 60" (Skoda trim levels)
        r'^nl-auto',           # NL-Auto
        r'^comfort',           # Trim levels
        r'^luxury',
        r'^business',
        r'^sport',
        r'^executive',
        r'^dynamic',
        r'^plus$',             # "Plus" trim (but not as part of model like "e-Niro Plus")
        r'^premium',
        r'^edition',
        r'^pro$',              # "Pro" trim
        r'^performance$',      # "Performance" trim
        r'^line$',
        r'^package',
        r'^\|',                # Pipe separator
        r'^-$',                # Dash separator
        r'^camera',            # Features
        r'^navi',
        r'^leder',
        r'^apple',
        r'^android',
        r'^acc$',
    ]
    
    # Known multi-word models that should be kept together
    multi_word_models = [
        'e-tron', 'q4 e-tron', 'model 3', 'model s', 'model x', 'model y',
        'i4', 'ix', 'ix3', 'mustang mach-e', 'ioniq 5', 'ioniq 6',
        'e niro', 'e-niro', 'e soul', 'e-soul', 'id.3', 'id.4', 'id.5', 'id.7'
    ]
    
    # Check if the full string starts with a known multi-word model
    model_lower = model_str.lower()
    for multi in multi_word_models:
        if model_lower.startswith(multi):
            # Return the multi-word model
            return ' '.join(model_str.split()[:len(multi.split())])
    
    # Extract model name (usually first 1-3 words before trim indicators)
    model_parts = []
    for i, word in enumerate(words):
        word_lower = word.lower()
        
        # Check if this word matches a trim indicator
        is_trim = any(re.match(pattern, word_lower) for pattern in trim_indicators)
        
        if is_trim:
            # Stop here - we've reached the trim/variant section
            break
        
        # Check if this word + next word form a trim pattern (e.g., "iV 80")
        if i + 1 < len(words):
            two_word_pattern = f"{word_lower} {words[i + 1].lower()}"
            is_two_word_trim = any(re.match(pattern, two_word_pattern) for pattern in trim_indicators)
            if is_two_word_trim:
                # Stop here - the current word starts a trim pattern
                break
        
        # Add word to model parts
        model_parts.append(word)
        
        # Stop after 3 words (most models are 1-3 words)
        if len(model_parts) >= 3:
            break
        
        # Special case: if next word looks like a trim level, stop here
        if i + 1 < len(words):
            next_word = words[i + 1].lower()
            if any(re.match(pattern, next_word) for pattern in trim_indicators):
                break
    
    # If we didn't find anything, return the first word
    if not model_parts:
        return words[0]
    
    return ' '.join(model_parts)


def normalize_fuel_type(fuel_type_str: str, model_str: str = None) -> Optional[str]:
    """
    Normalize fuel type strings to standard values
    
    Args:
        fuel_type_str: Raw fuel type string from website
        model_str: Optional model string to help detect mild hybrids
        
    Returns:
        Normalized fuel type: "Full Electric", "PHEV", "Hydrogen", or None
        Returns None for benzine/diesel/gasoline (to be filtered out)
    """
    if not fuel_type_str:
        return None
    
    fuel_lower = fuel_type_str.lower().strip()
    
    # Check for mild hybrids first - these should be excluded
    if is_mild_hybrid(fuel_type_str, model_str):
        logger.debug(f"Excluding mild hybrid: {fuel_type_str}")
        return None  # Exclude mild hybrids
    
    # Check for PHEV first (before rejecting benzine)
    # Dutch sites often use "Hybride benzine" or "Benzine hybrid"
    if any(term in fuel_lower for term in ['hybride benzine', 'benzine hybride', 'hybrid benzine', 'benzine hybrid', 'phev', 'plug-in', 'plugin', 'plug in']):
        return "PHEV"
    
    # Explicitly reject benzine/gasoline/diesel cars
    benzine_terms = ['benzine', 'gasoline', 'petrol', 'diesel', 'gasoil', 'lpg', 'cng']
    if any(term in fuel_lower for term in benzine_terms):
        logger.debug(f"Rejecting benzine/diesel car: {fuel_type_str}")
        return None
    
    # Hydrogen fuel cell variants (Toyota Mirai, Hyundai NEXO, etc.)
    if any(term in fuel_lower for term in ['waterstof', 'hydrogen', 'fuel cell', 'fcev', 'h2']):
        return "Hydrogen"
    
    # Electric variants
    if any(term in fuel_lower for term in ['electric', 'elektrisch', 'ev', 'bev']):
        if 'plug' in fuel_lower or 'hybrid' in fuel_lower or 'phev' in fuel_lower:
            return "PHEV"
        return "Full Electric"
    
    # PHEV variants
    if any(term in fuel_lower for term in ['phev', 'plug-in', 'plugin']):
        return "PHEV"
    
    # Hybrid (but not plug-in) - not what we're looking for
    if 'hybrid' in fuel_lower:
        logger.debug(f"Excluding non-PHEV hybrid: {fuel_type_str}")
        return "Hybrid"  # Will be filtered out
    
    # If we get here, it's probably benzine/diesel without explicit keyword
    logger.debug(f"Unknown fuel type (likely benzine/diesel): {fuel_type_str}")
    return None


def normalize_vehicle_type(vehicle_type_str: str, model_str: str = None, make_str: str = None) -> Optional[str]:
    """
    Normalize vehicle type strings to standard values
    
    Args:
        vehicle_type_str: Raw vehicle type string from website
        model_str: Optional model name to check if vehicle_type_str is empty
        make_str: Optional make/brand name for model-specific classification
        
    Returns:
        Normalized vehicle type: "SUV", "Stationwagon", or None
    """
    if not vehicle_type_str and not model_str:
        return None
    
    # Check the vehicle_type_str first
    if vehicle_type_str:
        vehicle_lower = vehicle_type_str.lower().strip()
        
        # SUV variants
        if any(term in vehicle_lower for term in ['suv', 'sport utility']):
            return "SUV"
        
        # Stationwagon variants
        if any(term in vehicle_lower for term in ['station', 'stationwagen', 'estate', 'kombi', 'wagon', 'tourer', 'sportstourer', 'sporttourer', 'variant', 'touring', 'avant']):
            return "Stationwagon"
    
    # Check model-specific classification from config
    if make_str and model_str and _vehicle_classification:
        # Normalize model string for matching (handle spaces, dashes, dots)
        model_normalized = model_str.lower().replace(' ', '').replace('-', '').replace('.', '')
        
        # Check SUV models
        suv_models = _vehicle_classification.get('suv_models', {})
        if make_str in suv_models:
            model_keywords = suv_models[make_str]
            for keyword in model_keywords:
                keyword_normalized = keyword.lower().replace(' ', '').replace('-', '').replace('.', '')
                if keyword_normalized in model_normalized:
                    return "SUV"
        
        # Check Stationwagon models
        wagon_models = _vehicle_classification.get('stationwagon_models', {})
        if make_str in wagon_models:
            model_keywords = wagon_models[make_str]
            for keyword in model_keywords:
                keyword_normalized = keyword.lower().replace(' ', '').replace('-', '').replace('.', '')
                if keyword_normalized in model_normalized:
                    return "Stationwagon"
    
    # Fallback: check the model name for keywords
    if model_str:
        model_lower = model_str.lower().strip()
        
        # SUV variants in model name
        if any(term in model_lower for term in ['suv', 'sport utility']):
            return "SUV"
        
        # Stationwagon variants in model name
        if any(term in model_lower for term in ['station', 'stationwagen', 'estate', 'kombi', 'wagon', 'tourer', 'sportstourer', 'sporttourer', 'variant', 'touring', 'avant', 'break']):
            return "Stationwagon"
    
    return None


def should_exclude_vehicle(make_str: str, model_str: str) -> bool:
    """
    Check if a vehicle should be excluded (too small for family use)
    
    Args:
        make_str: Vehicle make/brand
        model_str: Vehicle model
        
    Returns:
        True if vehicle should be excluded, False otherwise
    """
    if not _vehicle_classification:
        return False
    
    import re
    
    exclude_models = _vehicle_classification.get('exclude_models', {})
    if make_str in exclude_models:
        model_keywords = exclude_models[make_str]
        # If the list is empty, exclude all models from this make
        if not model_keywords:
            return True
        # Otherwise check if any keyword matches
        for keyword in model_keywords:
            keyword_lower = str(keyword).lower()
            model_lower = model_str.lower()
            
            # Use word boundary matching to avoid partial matches
            # This ensures "3" matches "Mazda 3" but not "CX-30"
            # Pattern: keyword must be preceded/followed by word boundary, space, or dash
            pattern = r'(?:^|[\s\-])' + re.escape(keyword_lower) + r'(?:[\s\-]|$)'
            if re.search(pattern, model_lower):
                return True
    
    return False


def extract_number(text: str) -> Optional[int]:
    """
    Extract first number from a string
    
    Args:
        text: String potentially containing a number
        
    Returns:
        Extracted integer or None
    """
    if not text:
        return None
    
    import re
    # Remove non-numeric characters except digits
    numbers = re.findall(r'\d+', str(text).replace('.', '').replace(',', ''))
    
    if numbers:
        return int(numbers[0])
    
    return None


def extract_price(text: str) -> Optional[float]:
    """
    Extract price from a string
    
    Args:
        text: String containing price (e.g., "€ 25.000", "25000 EUR")
        
    Returns:
        Price as float or None
    """
    if not text:
        return None
    
    import re
    # Remove currency symbols and spaces
    cleaned = str(text).replace('€', '').replace('EUR', '').replace(' ', '').replace('.', '').replace(',', '.')
    
    # Extract number
    match = re.search(r'\d+\.?\d*', cleaned)
    if match:
        try:
            return float(match.group())
        except ValueError:
            return None
    
    return None


def format_price(price: float) -> str:
    """
    Format price for display
    
    Args:
        price: Price value
        
    Returns:
