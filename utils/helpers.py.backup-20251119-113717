                address = result.raw.get('address', {})
                province = (address.get('state') or 
                          address.get('province') or 
                          address.get('county'))
                if province:
                    return province
    
    except Exception as e:
        logger.debug(f"Error extracting province for {city}: {e}")
    
    return None


