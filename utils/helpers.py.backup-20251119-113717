        match_score = len(overlap)
        
        # Also give points for substring matching
        if model_pattern_lower in model_lower or model_lower in model_pattern_lower:
            match_score += 5
        
        if match_score > best_match_score:
            best_match_score = match_score
            best_match = space_data
    
    if best_match and best_match_score > 0:
        logger.debug(f"Found boot space for {make} {model}: {best_match}")
