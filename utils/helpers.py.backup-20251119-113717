    try:
        # Determine if this is a PHEV
        is_phev = fuel_type and fuel_type.lower() in ['phev', 'plug-in hybrid', 'hybrid']
        
        # Build search query for RDW vehicle database
        # Search for vehicles matching make and model name
        model_search = model.split()[0]  # Use first word of model for broader matching
        
        # Query main vehicle dataset to find matching vehicles
        base_url = "https://opendata.rdw.nl/resource/m9d7-ebf2.json"
        params = {
            "$where": f"merk='{make.upper()}' AND handelsbenaming LIKE '%{model_search.upper()}%'",
            "$select": "kenteken",
            "$limit": 10,
            "$order": "datum_eerste_toelating DESC"
        }
        
        logger.debug(f"Querying RDW for {make} {model}...")
        response = requests.get(base_url, params=params, timeout=10)
        
        if response.status_code != 200:
            logger.debug(f"RDW query failed with status {response.status_code}")
            return None
        
        vehicles = response.json()
        if not vehicles:
            logger.debug(f"No vehicles found in RDW for {make} {model}")
            return None
        
        # Query fuel/range data for these vehicles
        ranges = []
        fuel_url = "https://opendata.rdw.nl/resource/8ys7-d773.json"
        
        for vehicle in vehicles[:5]:  # Check first 5 matches
            kenteken = vehicle.get('kenteken')
            if not kenteken:
                continue
            
            fuel_params = {"kenteken": kenteken}
            fuel_response = requests.get(fuel_url, params=fuel_params, timeout=10)
            
            if fuel_response.status_code == 200:
                fuel_data = fuel_response.json()
                
                for record in fuel_data:
                    # Check for electric vehicle
                    if record.get('brandstof_omschrijving') == 'Elektriciteit':
                        if is_phev:
                            # For PHEV, use external charging range
                            range_val = record.get('actie_radius_extern_opladen_wltp')
                        else:
                            # For full electric, use pure electric range
                            range_val = record.get('actie_radius_enkel_elektrisch_wltp')
                        
                        if range_val:
                            try:
                                range_km = int(range_val)
                                if range_km > 50:  # Sanity check: ignore unrealistic values
                                    ranges.append(range_km)
                                    logger.debug(f"Found RDW WLTP range for {make} {model}: {range_km} km (kenteken: {kenteken})")
                            except (ValueError, TypeError):
                                continue
        
        if ranges:
            # Return the most common range (mode), or median if all different
            from collections import Counter
            range_counts = Counter(ranges)
            most_common_range = range_counts.most_common(1)[0][0]
            logger.info(f"✓ RDW API: Found WLTP range for {make} {model}: {most_common_range} km")
            return most_common_range
        
    except requests.exceptions.Timeout:
        logger.debug(f"RDW API timeout for {make} {model}")
    except Exception as e:
        logger.debug(f"RDW API error for {make} {model}: {e}")
    
    return None


def get_wltp_range(make: str, model: str, fuel_type: str = None, ad_listed_range_km: Optional[int] = None) -> Optional[int]:
    """
    Get WLTP range estimate for a vehicle based on make, model, and extracted battery size
    
    Strategy: 
    1. Check manual YAML file first (fast, curated data)
    2. If not found, query RDW Open Data API (free, official Dutch vehicle data)
    
    Args:
        make: Vehicle make (e.g., "Volkswagen", "Tesla")
        model: Vehicle model (e.g., "ID.4 Pro 77 kWh", "Model 3 Long Range")
        fuel_type: Optional fuel type to determine if it's a PHEV
        ad_listed_range_km: Optional advertised range to help select correct battery variant
        
    Returns:
        Estimated WLTP range in km or None if not found
    """
    if not make or not model:
        return None
    
    wltp_data = _load_wltp_ranges()
    if not wltp_data:
        return None
    
    # Normalize make name (case-insensitive lookup)
    make_normalized = make.strip()
    model_lower = model.lower()
    
    # Check if this is a PHEV request
    is_phev = fuel_type and fuel_type.lower() in ['phev', 'plug-in hybrid', 'hybrid']
    
    if is_phev:
        # Look in PHEV section ONLY
        phev_data = wltp_data.get('PHEV', {})
        
        # Case-insensitive make lookup
        make_data = None
        for phev_make, phev_models in phev_data.items():
            if phev_make.lower() == make_normalized.lower():
                make_data = phev_models
                break
        
        if make_data:
            # Try to match model name
            for phev_model, range_km in make_data.items():
                phev_model_lower = phev_model.lower()
                # Check if model keywords match
                if phev_model_lower in model_lower or model_lower in phev_model_lower:
                    logger.debug(f"Found PHEV WLTP range for {make} {model}: {range_km} km")
                    return range_km
                
                # Check for partial matches (e.g., "Leon" matches "Leon e-Hybrid")
                model_words = set(model_lower.split())
                phev_words = set(phev_model_lower.split())
                if len(model_words & phev_words) >= 1:  # At least one word matches
                    logger.debug(f"Found PHEV WLTP range for {make} {model} (partial match): {range_km} km")
                    return range_km
        
        # PHEV not found in PHEV section - return None to prevent matching EV data
        logger.debug(f"No PHEV WLTP range found for {make} {model}")
        return None
    
    # Look in regular EV section (case-insensitive)
    make_data = None
    for ev_make, ev_models in wltp_data.items():
        if ev_make.lower() == make_normalized.lower() and ev_make != 'PHEV':
            make_data = ev_models
            break
    
    if not make_data:
        return None
    
    # Try to find matching model
    best_match = None
    best_match_score = 0
    
    for model_pattern, battery_data in make_data.items():
        # Check if model pattern matches
        model_pattern_lower = model_pattern.lower()
        
        # Score the match based on how many words overlap
        pattern_words = set(model_pattern_lower.split())
        model_words = set(model_lower.split())
        overlap = pattern_words & model_words
        match_score = len(overlap)
        
        # Also give points for substring matching
        if model_pattern_lower in model_lower or model_lower in model_pattern_lower:
            match_score += 5
        
        if match_score > best_match_score:
            best_match_score = match_score
            best_match = (model_pattern, battery_data)
    
    if best_match and best_match_score > 0:
        model_pattern, battery_data = best_match
        
        if not isinstance(battery_data, dict):
            # Direct range value (no battery variants)
            logger.debug(f"Found WLTP range for {make} {model}: {battery_data} km")
            return battery_data
        
        # Extract battery size from model string
        battery_size = extract_battery_size(model)
        
        if battery_size:
            # Look up range by battery size
            range_km = battery_data.get(battery_size)
            if range_km:
                logger.debug(f"Found WLTP range for {make} {model} ({battery_size} kWh): {range_km} km")
                return range_km
        
        # Fallback: try to match variant names in the model string
        # For example, "Long Range" → look for larger battery, "Standard Range" → smaller battery
        if 'long range' in model_lower or 'extended' in model_lower:
            # Get the largest battery size
            if battery_data:
                max_battery = max(battery_data.keys(), key=lambda x: int(x))
                range_km = battery_data[max_battery]
                logger.debug(f"Using WLTP range for {make} {model} (Long Range variant, {max_battery} kWh): {range_km} km")
                return range_km
        elif 'standard' in model_lower or 'base' in model_lower:
            # Get the smallest battery size
            if battery_data:
                min_battery = min(battery_data.keys(), key=lambda x: int(x))
                range_km = battery_data[min_battery]
                logger.debug(f"Using WLTP range for {make} {model} (Standard variant, {min_battery} kWh): {range_km} km")
                return range_km
        else:
            # If we can't determine variant, try using ad_listed_range_km for better matching
            if battery_data:
                if ad_listed_range_km:
                    # Use ad_listed_range to find the closest WLTP variant
                    # Two strategies:
                    # 1. If ad_range is 90-110% of any WLTP value, seller likely listed WLTP spec directly
                    # 2. Otherwise, treat as real-world range (expect 40-85% of WLTP)
                    
                    best_variant = None
                    best_score = float('inf')
                    
                    # Strategy 1: Check if ad_range matches any WLTP value directly (±10%)
                    for battery_kwh, wltp_range in battery_data.items():
                        ratio = ad_listed_range_km / wltp_range if wltp_range > 0 else 0
                        if 0.90 <= ratio <= 1.10:
                            # Direct WLTP match - return immediately
                            logger.debug(f"Ad-listed range matches WLTP spec for {make} {model}: "
                                       f"ad={ad_listed_range_km}km ≈ WLTP={wltp_range}km ({battery_kwh}kWh)")
                            return wltp_range
                    
                    # Strategy 2: Treat as real-world range, find best efficiency match
                    for battery_kwh, wltp_range in battery_data.items():
                        efficiency_ratio = ad_listed_range_km / wltp_range if wltp_range > 0 else 0
                        
                        # Only consider realistic efficiency ratios (40-85%)
                        if 0.40 <= efficiency_ratio <= 0.85:
                            # Calculate distance from ideal efficiency (60%)
                            ideal_efficiency = 0.60
                            distance_from_ideal = abs(efficiency_ratio - ideal_efficiency)
                            
                            if distance_from_ideal < best_score:
                                best_score = distance_from_ideal
                                best_variant = (battery_kwh, wltp_range, efficiency_ratio)
                    
                    if best_variant:
                        chosen_battery, fallback_range, efficiency = best_variant
                        logger.debug(f"Using ad-listed range-based WLTP for {make} {model}: "
                                   f"ad={ad_listed_range_km}km → WLTP={fallback_range}km "
                                   f"({chosen_battery}kWh, {efficiency:.1%} efficiency)")
                        return fallback_range
                
                # Original fallback: use the most common/largest battery
                # (usually the mid to upper range model, not the smallest)
                sorted_batteries = sorted(battery_data.keys(), key=lambda x: int(x))
                if len(sorted_batteries) == 1:
                    chosen_battery = sorted_batteries[0]
                elif len(sorted_batteries) == 2:
                    # Pick the larger of two options (more common)
                    chosen_battery = sorted_batteries[1]
                else:
                    # Pick the second-largest for 3+ options (most common mid-high trim)
                    chosen_battery = sorted_batteries[-2]
                
                fallback_range = battery_data[chosen_battery]
                logger.debug(f"Using fallback WLTP range for {make} {model} ({chosen_battery} kWh variant): {fallback_range} km")
                return fallback_range
    
    # YAML lookup failed - RDW API fallback is disabled for performance
    # The RDW API calls can take 1-2 seconds each with 10s timeouts
    # For ~150 cars on the top matches page, this causes 20-30 second load times
    logger.debug(f"WLTP not found in YAML for {make} {model} (RDW API fallback disabled for performance)")
    
    return None


def calculate_towing_range(car, ev_db_range=None) -> Optional[dict]:
    """
    Calculate estimated highway towing range for a tent trailer (750-1000kg)
    
    Args:
        car: Car object with range information
        ev_db_range: Optional pre-fetched EV-Database range data
        
    Returns:
        Dictionary with:
        - estimated_range_km: Estimated towing range in km
        - source: Which data source was used ('ev_database', 'ad_listed', 'wltp')
        - base_range: The base range value used for calculation
        - reduction_percent: Percentage reduction applied
        Returns None if no range data available
    """
    # Priority 1: EV-Database highway range (most accurate for highway towing)
    if ev_db_range and ev_db_range.get('highway_mild'):
        base_range = ev_db_range['highway_mild']
        reduction = 0.40  # 40% reduction for highway towing
        return {
            'estimated_range_km': int(base_range * (1 - reduction)),
            'source': 'EV-Database highway range',
            'base_range': int(base_range),
            'reduction_percent': int(reduction * 100)
        }
    
    # Priority 2: Listed in ad range (usually combined/WLTP, so more conservative reduction)
    ad_range = getattr(car, 'ad_listed_range_km', None) or getattr(car, 'electric_range_km', None)
    if ad_range:
        reduction = 0.45  # 45% reduction (ad ranges are often optimistic)
        return {
            'estimated_range_km': int(ad_range * (1 - reduction)),
            'source': 'Listed in ad',
            'base_range': int(ad_range),
            'reduction_percent': int(reduction * 100)
        }
    
    # Priority 3: WLTP range (most optimistic, so most conservative reduction)
    wltp_range = getattr(car, 'wltp_reference_range_km', None) or getattr(car, 'wltp_range', None)
    if wltp_range:
        reduction = 0.50  # 50% reduction (WLTP is very optimistic)
        return {
            'estimated_range_km': int(wltp_range * (1 - reduction)),
            'source': 'WLTP range',
            'base_range': int(wltp_range),
            'reduction_percent': int(reduction * 100)
        }
    
    return None


def find_duplicate_cars(car, db_session, threshold_km=5000, price_diff_pct=10):
    """
    Find potential duplicate listings of the same car
    
    A car is considered a potential duplicate if it matches:
    - Same make and model
    - Same year
    - Similar mileage (within threshold_km)
    - Similar price (within price_diff_pct percentage)
    - Different external_id (to exclude the same listing)
    - Is currently available (no point showing unavailable duplicates)
    
    Args:
        car: Car object to find duplicates for
        db_session: Database session
        threshold_km: Maximum mileage difference in km (default 5000)
        price_diff_pct: Maximum price difference as percentage (default 10%)
        
    Returns:
        List of potential duplicate Car objects
    """
    from models.database import Car
    
    if not car:
        return []
    
    # Calculate price range
    price_min = car.price * (1 - price_diff_pct / 100)
    price_max = car.price * (1 + price_diff_pct / 100)
    
    # Calculate mileage range
    mileage_min = max(0, car.mileage_km - threshold_km)
    mileage_max = car.mileage_km + threshold_km
    
    # Query for potential duplicates
    duplicates = db_session.query(Car).filter(
        Car.make == car.make,
        Car.model == car.model,
        Car.year == car.year,
        Car.mileage_km >= mileage_min,
        Car.mileage_km <= mileage_max,
        Car.price >= price_min,
        Car.price <= price_max,
        Car.external_id != car.external_id,  # Different listing
        Car.is_available == True  # Only show available duplicates
    ).all()
    
    return duplicates

