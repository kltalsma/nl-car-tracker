def is_within_budget(price: float, vehicle_type: str, search_config: dict) -> bool:
    """
    Check if car price is within budget for vehicle type
    
    Args:
        price: Car price
        vehicle_type: Vehicle type (SUV, Stationwagon)
        search_config: Search configuration from config.yaml
        
    Returns:
        True if within budget, False otherwise
    """
    if not price or not vehicle_type:
        return False
    
    for vehicle_config in search_config['vehicle_types']:
        if vehicle_config['type'] == vehicle_type:
            return price <= vehicle_config['max_price']
    
    return False


def meets_range_requirement(fuel_type: str, range_km: int, electric_range_km: int, search_config: dict) -> bool:
    """
    Check if car meets range requirements
    
    Args:
        fuel_type: Fuel type (Full Electric, PHEV)
        range_km: Total range in km
        electric_range_km: Electric-only range for PHEV
        search_config: Search configuration from config.yaml
        
    Returns:
        True if meets requirements, False otherwise
    """
    if not fuel_type:
        return False
    
    for fuel_config in search_config['fuel_types']:
        if fuel_config['type'] == fuel_type:
            if fuel_type == "Full Electric":
                return range_km >= fuel_config.get('min_range_km', 0)
            elif fuel_type == "PHEV":
                return electric_range_km >= fuel_config.get('min_electric_range_km', 0)
    
    return False


