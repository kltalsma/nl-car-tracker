            make_data = ev_models
            break
    
    if not make_data:
        return None
    
    # Try to find matching model using fuzzy matching
    best_match = None
    best_match_score = 0
    
    for model_pattern, range_data in make_data.items():
        # Check if model pattern matches
        model_pattern_lower = model_pattern.lower()
        
        # Score the match based on how many words overlap
        pattern_words = set(model_pattern_lower.split())
        model_words = set(model_lower.split())
        overlap = pattern_words & model_words
        match_score = len(overlap)
        
        # Prioritize exact matches (give them a very high score)
        if model_pattern_lower == model_lower:
            match_score += 100
        # Also give points for substring matching
        elif model_pattern_lower in model_lower or model_lower in model_pattern_lower:
            match_score += 5
        
