{% extends "base.html" %}

{% block title %}My Matches - NL Car Tracker{% endblock %}

{% block extra_css %}
<style>
    .requirement-box {
        background-color: #f8f9fa;
        border-left: 4px solid #16c79a;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 5px;
    }
    .dealbreaker-badge {
        background-color: #dc3545;
        color: white;
        font-weight: bold;
    }
    .met-badge {
        background-color: #28a745;
    }
    .missing-badge {
        background-color: #6c757d;
    }
    .aftermarket-note {
        background-color: #fff3cd;
        border-left: 4px solid #ffc107;
        padding: 10px;
        margin-top: 10px;
        border-radius: 5px;
    }
    .match-score {
        font-size: 1.2rem;
        font-weight: bold;
        color: #16c79a;
    }
    .incomplete-section {
        opacity: 0.85;
        background-color: #fff8f8;
    }
</style>
{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <!-- Sidebar with requirements -->
        <div class="col-md-3">
            <div class="requirement-box">
                <h5><i class="bi bi-clipboard-check"></i> Your Requirements</h5>
                
                <h6 class="mt-3 text-danger"><i class="bi bi-exclamation-triangle-fill"></i> CRITICAL FEATURES (MUST HAVE)</h6>
                <ul class="list-unstyled ms-2 small">
                    {% for feature in config.critical_features %}
                    <li><i class="bi bi-check-circle-fill text-danger"></i> {{ feature }}</li>
                    {% endfor %}
                </ul>
                
                <h6 class="mt-3"><i class="bi bi-heart-fill"></i> NICE TO HAVE</h6>
                <ul class="list-unstyled ms-2 small">
                    {% for feature in config.nice_to_have_features %}
                    <li><i class="bi bi-circle"></i> {{ feature }}</li>
                    {% endfor %}
                </ul>
                
                <h6 class="mt-3"><i class="bi bi-funnel-fill"></i> FILTERS</h6>
                <ul class="list-unstyled ms-2 small">
                    <li><strong>Price Range:</strong> €{{ "{:,}".format(user_reqs.min_price) }} - €{{ "{:,}".format(user_reqs.max_price) }}</li>
                    <li><strong>Year:</strong> {{ user_reqs.min_year }}+</li>
                    <li><strong>Mileage:</strong> <{{ "{:,}".format(user_reqs.max_mileage_priority) }} km (priority), <{{ "{:,}".format(user_reqs.max_mileage_acceptable) }} km (acceptable)</li>
                    <li><strong>Transmission:</strong> Automatic</li>
                </ul>
                
                <h6 class="mt-3"><i class="bi bi-star-fill"></i> PREFERRED</h6>
                <ul class="list-unstyled ms-2 small">
                    <li>Skoda Enyaq / Kodiaq</li>
                    <li>Audi e-tron</li>
                    <li>Kia EV5 / EV9</li>
                    <li>Stationwagons with 100km+ range</li>
                </ul>
            </div>
        </div>

        <!-- Main content -->
        <div class="col-md-9">
            <h3 class="mb-4"><i class="bi bi-heart-fill text-danger"></i> My Matches</h3>
            
            <!-- Perfect Matches Section -->
            {% if perfect_matches %}
            <div class="mb-5">
                <h4 class="text-success"><i class="bi bi-check-circle-fill"></i> All Critical Features Met ({{ perfect_matches|length }})</h4>
                <p class="text-muted">These cars have all {{ config.critical_features|length }} critical must-have features</p>
                
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
                    {% for item in perfect_matches %}
                    {% set car = item.car %}
                    <div class="col">
                        <div class="card car-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">{{ car.make }} {{ car.model }}</h5>
                                    <span class="match-score">{{ item.match_score }}</span>
                                </div>
                                
                                <p class="text-muted small mb-2">
                                    {{ car.year }} • {{ car.fuel_type }}
                                    {% if item.is_preferred_brand or item.is_preferred_model %}
                                    <span class="badge bg-success text-white"><i class="bi bi-star-fill"></i> PREFERRED</span>
                                    {% endif %}
                                </p>
                                
                                <div class="price-tag mb-3">{{ car.price | format_price }}</div>
                                
                                <div class="mb-2 small">
                                    <div class="mb-1">
                                        <i class="bi bi-speedometer"></i> {{ car.mileage_km | format_mileage }}
                                        {% if item.mileage_tier == 'priority' %}
                                        <span class="badge bg-success">LOW MILEAGE</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-calendar3"></i> {{ car.year }}
                                        {% if item.year_tier == 'preferred' %}
                                        <span class="badge bg-success">2021+</span>
                                        {% else %}
                                        <span class="badge bg-warning text-dark">2020</span>
                                        {% endif %}
                                    </div>
                                    {% if car.location_city %}
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt-fill"></i> {{ car.location_city }}
                                        {% if car.distance_from_heerenveen_km %}
                                            <span class="text-muted">({{ car.distance_from_heerenveen_km | format_distance }})</span>
                                        {% endif %}
                                    </div>
                                    {% elif car.distance_from_heerenveen_km %}
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt-fill"></i> {{ car.distance_from_heerenveen_km | format_distance }}
                                    </div>
                                    {% endif %}
                                    <div class="mb-1">
                                        <i class="bi bi-lightning-charge-fill"></i> 
                                        {% if item.range_value %}
                                            {% if car.fuel_type == 'PHEV' %}
                                                {{ item.range_value }} km electric{% if item.is_wltp_estimate %} <span class="badge bg-info text-dark">WLTP</span>{% endif %}
                                                {% if item.range_value < 40 %}
                                                <span class="badge bg-warning text-dark" title="Low electric range">⚠️ Low</span>
                                                {% endif %}
                                            {% else %}
                                                <div class="small">
                                                    {% if car.battery_size %}
                                                        <strong>Battery:</strong> {{ car.battery_size }} kWh<br>
                                                    {% endif %}
                                                    <strong>WLTP:</strong> 
                                                    {% if car.wltp_range %}
                                                        {{ car.wltp_range }} km
                                                        {% if item.range_value and car.wltp_range < item.range_value * 0.85 %}
                                                        <span class="badge bg-warning text-dark ms-1" title="WLTP unusually low - may indicate wrong battery variant match">⚠️</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>Listed in ad:</strong> 
                                                    {% if item.range_value %}
                                                        {{ item.range_value }} km
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>EV-Database:</strong> 
                                                    {% if car.ev_db_range %}
                                                        {{ car.ev_db_range.real_range|int }} km real-world (City: {{ car.ev_db_range.city_mild|int }} km, Highway: {{ car.ev_db_range.highway_mild|int }} km)
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>Towing (750-1000kg tent trailer):</strong> 
                                                    {% if car.towing_range %}
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Based on {{ car.towing_range.source }}">
                                                            ~{{ car.towing_range.estimated_range_km|int }} km highway
                                                        </span>
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">Could not be determined</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-briefcase-fill"></i> 
                                        {% if car.storage_capacity_liters %}
                                            {{ car.storage_capacity_liters }}L{% if car.storage_capacity_seats_down_liters %} / {{ car.storage_capacity_seats_down_liters }}L{% endif %} boot
                                        {% else %}
                                            <span class="text-muted">Could not be determined</span>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <!-- Critical Features (All Met) -->
                                <div class="mb-2">
                                    <strong class="small">Critical Features ({{ item.critical_features|length }}/{{ item.critical_features|length }}):</strong><br>
                                    {% for feature_name, has_it in item.critical_features.items() %}
                                    <span class="badge met-badge feature-badge">
                                        <i class="bi bi-check-circle-fill"></i> {{ feature_name }}
                                    </span>
                                    {% endfor %}
                                </div>
                                
                                <!-- Nice-to-Haves -->
                                <div class="mb-2">
                                    <strong class="small">Nice-to-Have ({{ item.nice_to_have_count }}/{{ config.nice_to_have_features|length }}):</strong><br>
                                    {% for nice_feature in config.nice_to_have_features %}
                                    {% set has_feature = nice_feature in item.nice_features_present %}
                                    <span class="badge {% if has_feature %}met-badge{% else %}missing-badge{% endif %} feature-badge">
                                        {% if has_feature %}<i class="bi bi-check-circle-fill"></i>{% else %}<i class="bi bi-x-circle-fill"></i>{% endif %} {{ nice_feature }}
                                    </span>
                                    {% endfor %}
                                </div>
                                
                                {% if 'Trekhaak' not in item.nice_features_present %}
                                <div class="aftermarket-note small">
                                    <i class="bi bi-info-circle-fill"></i> <strong>Trekhaak:</strong> Aftermarket installation possible (~€800-1500)
                                </div>
                                {% endif %}
                                
                                <div class="d-grid gap-2 mt-3">
                                    <a href="/car/{{ car.id }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-info-circle"></i> View Details
                                    </a>
                                    <a href="{{ car.listing_url }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-box-arrow-up-right"></i> View Listing
                                    </a>
                                </div>
                            </div>
                            <div class="card-footer">
                                <small class="text-muted">Last seen: {{ car.last_seen | format_datetime }}</small>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% else %}
            <div class="alert alert-warning mb-5">
                <i class="bi bi-exclamation-triangle-fill"></i> <strong>No perfect matches found!</strong> No cars currently meet all {{ config.critical_features|length }} critical feature requirements.
            </div>
            {% endif %}
            
            <!-- Great Matches Section (7-8/9 features) -->
            {% if great_matches %}
            <div class="mb-5">
                <h4 class="text-primary"><i class="bi bi-star-fill"></i> Great Matches ({{ great_matches|length }})</h4>
                <p class="text-muted">These cars have 7-8 out of {{ config.critical_features|length }} critical features - missing only 1-2 features</p>
                
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
                    {% for item in great_matches %}
                    {% set car = item.car %}
                    <div class="col">
                        <div class="card car-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">{{ car.make }} {{ car.model }}</h5>
                                    <span class="badge bg-primary">{{ (item.critical_features.values()|select|list|length) }}/{{ total_critical }}</span>
                                </div>
                                
                                <p class="text-muted small mb-2">
                                    {{ car.year }} • {{ car.fuel_type }}
                                    {% if item.is_preferred_brand or item.is_preferred_model %}
                                    <span class="badge bg-success text-white"><i class="bi bi-star-fill"></i> PREFERRED</span>
                                    {% endif %}
                                </p>
                                
                                <div class="price-tag mb-3">{{ car.price | format_price }}</div>
                                
                                <div class="mb-2 small">
                                    <div class="mb-1">
                                        <i class="bi bi-speedometer"></i> {{ car.mileage_km | format_mileage }}
                                        {% if item.mileage_tier == 'priority' %}
                                        <span class="badge bg-success">LOW MILEAGE</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-calendar3"></i> {{ car.year }}
                                        {% if item.year_tier == 'preferred' %}
                                        <span class="badge bg-success">2021+</span>
                                        {% else %}
                                        <span class="badge bg-warning text-dark">2020</span>
                                        {% endif %}
                                    </div>
                                    {% if car.location_city %}
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt-fill"></i> {{ car.location_city }}
                                        {% if car.distance_from_heerenveen_km %}
                                            <span class="text-muted">({{ car.distance_from_heerenveen_km | format_distance }})</span>
                                        {% endif %}
                                    </div>
                                    {% elif car.distance_from_heerenveen_km %}
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt-fill"></i> {{ car.distance_from_heerenveen_km | format_distance }}
                                    </div>
                                    {% endif %}
                                    <div class="mb-1">
                                        <i class="bi bi-lightning-charge-fill"></i> 
                                        {% if item.range_value %}
                                            {% if car.fuel_type == 'PHEV' %}
                                                {{ item.range_value }} km electric{% if item.is_wltp_estimate %} <span class="badge bg-info text-dark">WLTP</span>{% endif %}
                                                {% if item.range_value < 40 %}
                                                <span class="badge bg-warning text-dark" title="Low electric range">⚠️ Low</span>
                                                {% endif %}
                                            {% else %}
                                                <div class="small">
                                                    {% if car.battery_size %}
                                                        <strong>Battery:</strong> {{ car.battery_size }} kWh<br>
                                                    {% endif %}
                                                    <strong>WLTP:</strong> 
                                                    {% if car.wltp_range %}
                                                        {{ car.wltp_range }} km
                                                        {% if item.range_value and car.wltp_range < item.range_value * 0.85 %}
                                                        <span class="badge bg-warning text-dark ms-1" title="WLTP unusually low - may indicate wrong battery variant match">⚠️</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>Listed in ad:</strong> 
                                                    {% if item.range_value %}
                                                        {{ item.range_value }} km
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>EV-Database:</strong> 
                                                    {% if car.ev_db_range %}
                                                        {{ car.ev_db_range.real_range|int }} km real-world (City: {{ car.ev_db_range.city_mild|int }} km, Highway: {{ car.ev_db_range.highway_mild|int }} km)
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>Towing (750-1000kg tent trailer):</strong> 
                                                    {% if car.towing_range %}
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Based on {{ car.towing_range.source }}">
                                                            ~{{ car.towing_range.estimated_range_km|int }} km highway
                                                        </span>
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">Could not be determined</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-briefcase-fill"></i> 
                                        {% if car.storage_capacity_liters %}
                                            {{ car.storage_capacity_liters }}L{% if car.storage_capacity_seats_down_liters %} / {{ car.storage_capacity_seats_down_liters }}L{% endif %} boot
                                        {% else %}
                                            <span class="text-muted">Could not be determined</span>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <!-- Critical Features (showing missing ones) -->
                                <div class="mb-2">
                                    <strong class="small">Critical Features ({{ (item.critical_features.values()|select|list|length) }}/{{ item.critical_features|length }}):</strong><br>
                                    {% for feature_name, has_it in item.critical_features.items() %}
                                    <span class="badge {% if has_it %}met-badge{% else %}dealbreaker-badge{% endif %} feature-badge">
                                        {% if has_it %}<i class="bi bi-check-circle-fill"></i>{% else %}<i class="bi bi-x-circle-fill"></i> MISSING{% endif %} {{ feature_name }}
                                    </span>
                                    {% endfor %}
                                </div>
                                
                                <!-- Nice-to-Haves -->
                                <div class="mb-2">
                                    <strong class="small">Nice-to-Have ({{ item.nice_to_have_count }}/{{ config.nice_to_have_features|length }}):</strong><br>
                                    {% for nice_feature in config.nice_to_have_features %}
                                    {% set has_feature = nice_feature in item.nice_features_present %}
                                    <span class="badge {% if has_feature %}met-badge{% else %}missing-badge{% endif %} feature-badge">
                                        {% if has_feature %}<i class="bi bi-check-circle-fill"></i>{% else %}<i class="bi bi-x-circle-fill"></i>{% endif %} {{ nice_feature }}
                                    </span>
                                    {% endfor %}
                                </div>
                                
                                {% if 'Trekhaak' not in item.nice_features_present %}
                                <div class="aftermarket-note small">
                                    <i class="bi bi-info-circle-fill"></i> <strong>Trekhaak:</strong> Aftermarket installation possible (~€800-1500)
                                </div>
                                {% endif %}
                                
                                <div class="d-grid gap-2 mt-3">
                                    <a href="/car/{{ car.id }}" class="btn btn-primary btn-sm">
                                        <i class="bi bi-info-circle"></i> View Details
                                    </a>
                                    <a href="{{ car.listing_url }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-box-arrow-up-right"></i> View Listing
                                    </a>
                                </div>
                            </div>
                            <div class="card-footer">
                                <small class="text-muted">Last seen: {{ car.last_seen | format_datetime }}</small>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            
            <!-- Good Matches Section (5-6/9 features) -->
            {% if good_matches %}
            <div class="mb-5">
                <h4 class="text-info"><i class="bi bi-star-half"></i> Good Matches ({{ good_matches|length }})</h4>
                <p class="text-muted">These cars have 5-6 out of {{ config.critical_features|length }} critical features - missing 3-4 features but still worth considering</p>
                
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-2">
                    {% for item in good_matches %}
                    {% set car = item.car %}
                    <div class="col">
                        <div class="card car-card h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="card-title mb-0">{{ car.make }} {{ car.model }}</h5>
                                    <span class="badge bg-info">{{ (item.critical_features.values()|select|list|length) }}/{{ total_critical }}</span>
                                </div>
                                
                                <p class="text-muted small mb-2">
                                    {{ car.year }} • {{ car.fuel_type }}
                                    {% if item.is_preferred_brand or item.is_preferred_model %}
                                    <span class="badge bg-success text-white"><i class="bi bi-star-fill"></i> PREFERRED</span>
                                    {% endif %}
                                </p>
                                
                                <div class="price-tag mb-3">{{ car.price | format_price }}</div>
                                
                                <div class="mb-2 small">
                                    <div class="mb-1">
                                        <i class="bi bi-speedometer"></i> {{ car.mileage_km | format_mileage }}
                                        {% if item.mileage_tier == 'priority' %}
                                        <span class="badge bg-success">LOW MILEAGE</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-calendar3"></i> {{ car.year }}
                                        {% if item.year_tier == 'preferred' %}
                                        <span class="badge bg-success">2021+</span>
                                        {% else %}
                                        <span class="badge bg-warning text-dark">2020</span>
                                        {% endif %}
                                    </div>
                                    {% if car.location_city %}
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt-fill"></i> {{ car.location_city }}
                                        {% if car.distance_from_heerenveen_km %}
                                            <span class="text-muted">({{ car.distance_from_heerenveen_km | format_distance }})</span>
                                        {% endif %}
                                    </div>
                                    {% elif car.distance_from_heerenveen_km %}
                                    <div class="mb-1">
                                        <i class="bi bi-geo-alt-fill"></i> {{ car.distance_from_heerenveen_km | format_distance }}
                                    </div>
                                    {% endif %}
                                    <div class="mb-1">
                                        <i class="bi bi-lightning-charge-fill"></i> 
                                        {% if item.range_value %}
                                            {% if car.fuel_type == 'PHEV' %}
                                                {{ item.range_value }} km electric{% if item.is_wltp_estimate %} <span class="badge bg-info text-dark">WLTP</span>{% endif %}
                                                {% if item.range_value < 40 %}
                                                <span class="badge bg-warning text-dark" title="Low electric range">⚠️ Low</span>
                                                {% endif %}
                                            {% else %}
                                                <div class="small">
                                                    {% if car.battery_size %}
                                                        <strong>Battery:</strong> {{ car.battery_size }} kWh<br>
                                                    {% endif %}
                                                    <strong>WLTP:</strong> 
                                                    {% if car.wltp_range %}
                                                        {{ car.wltp_range }} km
                                                        {% if item.range_value and car.wltp_range < item.range_value * 0.85 %}
                                                        <span class="badge bg-warning text-dark ms-1" title="WLTP unusually low - may indicate wrong battery variant match">⚠️</span>
                                                        {% endif %}
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>Listed in ad:</strong> 
                                                    {% if item.range_value %}
                                                        {{ item.range_value }} km
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>EV-Database:</strong> 
                                                    {% if car.ev_db_range %}
                                                        {{ car.ev_db_range.real_range|int }} km real-world (City: {{ car.ev_db_range.city_mild|int }} km, Highway: {{ car.ev_db_range.highway_mild|int }} km)
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                    <br>
                                                    <strong>Towing (750-1000kg tent trailer):</strong> 
                                                    {% if car.towing_range %}
                                                        <span data-bs-toggle="tooltip" data-bs-placement="top" title="Based on {{ car.towing_range.source }}">
                                                            ~{{ car.towing_range.estimated_range_km|int }} km highway
                                                        </span>
                                                    {% else %}
                                                        <span class="text-muted">-</span>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                        {% else %}
                                            <span class="text-muted">Could not be determined</span>
                                        {% endif %}
                                    </div>
                                    <div class="mb-1">
                                        <i class="bi bi-briefcase-fill"></i> 
                                        {% if car.storage_capacity_liters %}
                                            {{ car.storage_capacity_liters }}L{% if car.storage_capacity_seats_down_liters %} / {{ car.storage_capacity_seats_down_liters }}L{% endif %} boot
                                        {% else %}
                                            <span class="text-muted">Could not be determined</span>
                                        {% endif %}
                                    </div>
                                </div>
                                
                                <!-- Critical Features (showing missing ones) -->
                                <div class="mb-2">
                                    <strong class="small">Critical Features ({{ (item.critical_features.values()|select|list|length) }}/{{ item.critical_features|length }}):</strong><br>
                                    {% for feature_name, has_it in item.critical_features.items() %}
                                    <span class="badge {% if has_it %}met-badge{% else %}dealbreaker-badge{% endif %} feature-badge">
                                        {% if has_it %}<i class="bi bi-check-circle-fill"></i>{% else %}<i class="bi bi-x-circle-fill"></i> MISSING{% endif %} {{ feature_name }}
                                    </span>
                                    {% endfor %}
                                </div>
                                
                                <!-- Nice-to-Haves -->
                                <div class="mb-2">
                                    <strong class="small">Nice-to-Have ({{ item.nice_to_have_count }}/{{ config.nice_to_have_features|length }}):</strong><br>
                                    {% for nice_feature in config.nice_to_have_features %}
                                    {% set has_feature = nice_feature in item.nice_features_present %}
                                    <span class="badge {% if has_feature %}met-badge{% else %}missing-badge{% endif %} feature-badge">
                                        {% if has_feature %}<i class="bi bi-check-circle-fill"></i>{% else %}<i class="bi bi-x-circle-fill"></i>{% endif %} {{ nice_feature }}
                                    </span>
                                    {% endfor %}
                                </div>
                                
                                {% if 'Trekhaak' not in item.nice_features_present %}
                                <div class="aftermarket-note small">
                                    <i class="bi bi-info-circle-fill"></i> <strong>Trekhaak:</strong> Aftermarket installation possible (~€800-1500)
                                </div>
                                {% endif %}
                                
                                <div class="d-grid gap-2 mt-3">
                                    <a href="/car/{{ car.id }}" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-info-circle"></i> View Details
                                    </a>
                                    <a href="{{ car.listing_url }}" target="_blank" class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-box-arrow-up-right"></i> View Listing
                                    </a>
                                </div>
                            </div>
                            <div class="card-footer">
                                <small class="text-muted">Last seen: {{ car.last_seen | format_datetime }}</small>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
            
            <!-- Note: Cars with fewer than 5/9 critical features are not shown as they have too many dealbreakers -->
            
            {% if not perfect_matches and not great_matches and not good_matches %}
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No cars found with at least 5 out of {{ config.critical_features|length }} critical features. Try running the scrapers or adjusting your requirements.
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    // Initialize Bootstrap tooltips
    document.addEventListener('DOMContentLoaded', function() {
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
        var tooltipList = tooltipTriggerList.map(function(tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl);
        });
    });
</script>
{% endblock %}
